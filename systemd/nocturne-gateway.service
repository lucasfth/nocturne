[Unit]
Description=nocturne inference coordinator
After=network.target

[Service]
ExecStart=%h/nocturne/.venv/bin/python -m gateway
WorkingDirectory=%h/nocturne
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/nocturne/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=default.target
